rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() &&
        (isOwner(resource.data.createdBy) ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeCount']));
      allow delete: if isAuth() && isOwner(resource.data.createdBy);
    }

    match /spots/{spotId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() &&
        (isOwner(resource.data.createdBy) ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photos', 'rating', 'ratingCount']));
      allow delete: if isAuth() && isOwner(resource.data.createdBy);
    }

    match /routes/{routeId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() &&
        (isOwner(resource.data.createdBy) ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']));
      allow delete: if isAuth() && isOwner(resource.data.createdBy);
    }
  }
}
